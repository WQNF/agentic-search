# Application
APP_NAME=Agentic Research
APP_ENV=development
DEBUG=true
SECRET_KEY=change_me_to_a_random_string
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=research
POSTGRES_PASSWORD=research_password
POSTGRES_DB=research_db

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# LLM
DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Search
TAVILY_API_KEY=your_tavily_api_key
SERPER_API_KEY=your_serper_api_key   # optional
SEARCH_PROVIDER=tavily   # tavily or serper

# Data Source
SEC_USER_AGENT=your-email@example.com